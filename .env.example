# ==============================================================================
# Fake News Detection System - Environment Configurations Example
# Copy this file to '.env' and adjust the variables for local/production environments.
# ==============================================================================

# --- General System Configuration ---
PROJECT_NAME="Fake News Detection System"
ENVIRONMENT=development # development, staging, production
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY=supersecretkeyreplaceinproduction1234567890!@#

# --- Backend API Server Settings ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# --- Database Configurations (PostgreSQL example) ---
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=fakenewsdb
POSTGRES_PORT=5432

# --- Redis Configuration (Caching & Task Queues) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- ML Model Configuration ---
# Options: transformer (BERT), classic (TF-IDF + LogisticRegression), hybrid
MODEL_TYPE=transformer
MODEL_PATH=/app/model/artifacts/fake_news_bert_v1
MAX_SEQUENCE_LENGTH=512
CONFIDENCE_THRESHOLD=0.75

# --- File Upload Limits & Paths ---
MAX_UPLOAD_SIZE_MB=5
UPLOAD_DIR=/app/uploads
ALLOWED_EXTENSIONS=["txt", "pdf", "docx"]

# --- Frontend Settings ---
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_TITLE="Fake News Detection System"
