# ==============================================================================
# Environment Variables — Copy to .env and fill in your values
# ==============================================================================

# --- App Settings ---
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=replace-this-with-a-strong-random-secret-key

# --- Database ---
# Option A: SQLite (default — zero config, data stored on Render Disk)
# Leave DATABASE_URL empty to use SQLite at ./fakenews.db
DATABASE_URL=

# Option B: Render PostgreSQL addon (persistent, recommended for production)
# Render sets this automatically when you attach a PostgreSQL addon
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- CORS (comma-separated list of allowed frontend origins) ---
# Set this to your Render frontend URL after deployment
BACKEND_CORS_ORIGINS=https://fake-news-frontend.onrender.com

# --- ML Config ---
MODEL_TYPE=tfidf
MODEL_PATH=/data/model/artifacts
CONFIDENCE_THRESHOLD=0.75

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=5
UPLOAD_DIR=/data/uploads
